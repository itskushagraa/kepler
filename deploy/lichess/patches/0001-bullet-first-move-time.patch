diff --git a/lib/engine_wrapper.py b/lib/engine_wrapper.py
--- a/lib/engine_wrapper.py
+++ b/lib/engine_wrapper.py
@@ -699,7 +699,10 @@ def first_move_time(game: model.Game) -> chess.engine.Limit:
     :param game: The game that the bot is playing.
     :return: The time to choose the first move.
     """
-    # Need to hardcode first movetime since Lichess has 30 sec limit.
-    search_time = seconds(10)
+    # Lichess uses a special first-move deadline, so a clock command cannot be
